---
layout: null
permalink: /data.json
---
{%- assign projects = site.proyectos | sort: 'num' -%}
{%- assign archives = site.archivo | sort: 'num' -%}
{%- assign contents = site.contenido -%}
{
"site": {
  "title": {{ site.title | jsonify }},
  "baseurl": {{ site.baseurl | jsonify }}
},
"content": {
  {%- for item in contents -%}
  {%- assign content_key = item.path | split: '/' | last | remove: '.md' -%}{{ content_key | jsonify }}: {"title": {{ item.title | default: '' | jsonify }}, "label": {{ item.label | default: '' | jsonify }}, "body": {{ item.content | markdownify | jsonify }}, "email": {{ item.email | default: '' | jsonify }}, "image": {{ item.image | default: '' | jsonify }}, "tags": {{ item.tags | jsonify }}, "links": {{ item.links | jsonify }} }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
},
"proyectos": [
  {%- for item in projects -%}
  {%- assign rendered_body = item.content -%}
  {"id": {{ item.id | jsonify }}, "num": {{ item.num | jsonify }}, "title": {{ item.title | jsonify }}, "category": {{ item.category | jsonify }}, "categoryTag": {{ item.categoryTag | jsonify }}, "year": {{ item.year | jsonify }}, "client": {{ item.client | jsonify }}, "image": {{ item.image | jsonify }}, "gallery": {{ item.gallery | jsonify }}, "media": {{ item.media | jsonify }}, "tools": {{ item.tools | jsonify }}, "status": {{ item.status | jsonify }}, "concept": {{ rendered_body | jsonify }}, "process": "" }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
],
"archivo": [
  {%- for item in archives -%}
  {%- assign rendered_body = item.content -%}
  {"id": {{ item.id | jsonify }}, "num": {{ item.num | jsonify }}, "title": {{ item.title | jsonify }}, "category": {{ item.category | jsonify }}, "categoryTag": {{ item.categoryTag | jsonify }}, "year": {{ item.year | jsonify }}, "client": {{ item.client | jsonify }}, "image": {{ item.image | jsonify }}, "gallery": {{ item.gallery | jsonify }}, "media": {{ item.media | jsonify }}, "tools": {{ item.tools | jsonify }}, "status": {{ item.status | jsonify }}, "concept": {{ rendered_body | jsonify }}, "process": "" }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
}
